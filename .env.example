# TMDB API Read Access Token (Bearer token, not the v3 API key)
EXPO_PUBLIC_MOVIE_API_KEY=

# Optional: enables search tracking and trending movies
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
EXPO_PUBLIC_APPWRITE_DATABASE_ID=
EXPO_PUBLIC_APPWRITE_COLLECTION_ID=

# Public HTTPS backend URL; NEVER put Meta tokens in EXPO_PUBLIC_ values.
EXPO_PUBLIC_INSTAGRAM_OEMBED_ENDPOINT=

# Optional HTTPS discovery backend. Default Shorts flow needs no backend/key.
EXPO_PUBLIC_SHORTS_ENDPOINT=
