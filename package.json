{
  "name": "rn-movie-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "android:native": "expo run:android",
    "build:android:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Mode Preview",
    "build:android:production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Mode Bundle",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --runInBand --cacheDirectory .expo/jest-cache",
    "lint": "expo lint",
    "build:android:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Mode Bundle",
    "build:android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Mode Preview",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.task-backups/",
      "/android/",
      "/dist/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.task-backups/",
      "<rootDir>/.credentials/",
      "<rootDir>/.expo/build-tmp/"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "expo": "~54.0.0",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "nativewind": "^4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-appwrite": "^0.7.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-heroicons": "^4.0.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "tailwindcss": "^3.4.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "react-native-worklets": "0.5.1",
    "@expo/metro-runtime": "~6.1.2",
    "expo-file-system": "~19.0.24",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.0.0",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.18",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "babel-preset-expo": "~54.0.12"
  },
  "private": true,
  "overrides": {
    "postcss": "8.5.30",
    "postcss-selector-parser": "7.1.6",
    "react-native-appwrite": {
      "expo-file-system": "~19.0.24"
    }
  }
}
